# ============================================================
# GATEPOINT ENVIRONMENT VARIABLES
# ============================================================
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.
# ============================================================

# ---- Supabase ----
NEXT_PUBLIC_SUPABASE_URL=your-supabase-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
# Required for automatic QR code generation after attendee registration.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ---- App ----
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Gatepoint

# ---- Resend (Email) ----
RESEND_API_KEY=your-resend-api-key
RESEND_FROM_EMAIL=noreply@yourdomain.com

# ---- QR Code ----
# Base URL for QR code data (defaults to NEXT_PUBLIC_APP_URL)
# QR_CODE_BASE_URL=https://yourdomain.com
